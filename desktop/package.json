{
  "name": "ireadmanga-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-bundle": "node prepare.mjs",
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "site.ireadmanga.desktop",
    "productName": "I Read Manga",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "bundle/client-dist",
        "to": "client-dist"
      },
      {
        "from": "bundle/server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
